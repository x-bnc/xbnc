[Unit]
Description=xBNC IRC bouncer
Documentation=file:///usr/local/share/doc/xbnc/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xbnc
Group=xbnc
Environment=XBNC_CONFIG=/etc/xbnc/xbnc.toml
ExecStartPre=/usr/local/bin/xbncd check-config
ExecStart=/usr/local/bin/xbncd run
# Applies networks/channels/users changed with the CLI.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# The process needs no privileges. Ports below 1024 would need
# AmbientCapabilities=CAP_NET_BIND_SERVICE; the defaults use 6697.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/xbnc
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
