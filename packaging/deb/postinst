#!/bin/sh
set -e
case "$1" in
    configure)
        systemctl daemon-reload >/dev/null 2>&1 || true
        # Panel updates (only act with [updates] public_key and a signed package).
        systemctl enable --now xbnc-update.path >/dev/null 2>&1 || true
        if [ -z "$2" ] && [ ! -f /etc/xbnc/xbnc.toml ]; then
            # First installation: leave it ready to use.
            /usr/sbin/xbnc-setup || echo "xBNC: configuration failed; run 'sudo xbnc-setup' to retry."
        else
            # Upgrade: the database is migrated when the service starts.
            systemctl try-restart xbnc >/dev/null 2>&1 || true
        fi
        ;;
esac
exit 0
